{
  "name": "axtify",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "An independent, local-first music player informed by Spotify REA research",
  "license": "MIT",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "desktop": "electron .",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "pack:desktop": "electron-builder --dir --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "desktop/main.cjs",
  "author": "Axtify contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/reddeadplsss/axtify.git"
  },
  "build": {
    "appId": "io.github.reddeadplsss.axtify",
    "productName": "Axtify",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "LICENSE",
      "package.json",
      "build/icon.png"
    ],
    "asar": true,
    "publish": null,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "forceCodeSigning": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Axtify-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Axtify-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "AudioVideo"
    }
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.1"
  }
}
